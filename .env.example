# Private key for the deployer wallet (no 0x prefix needed for cast, but forge needs it)
PRIVATE_KEY=

# Sepolia RPC endpoint (e.g. from Alchemy, Infura, or any public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Address of a ContinuousClearingAuction instance deployed via the factory at
# 0x000000001F26a0044BaA66024e7b6599c61963F8 on Sepolia.
# Create one with script/LaunchCcaSepolia.s.sol, on https://app.uniswap.org/launch,
# or via the factory contract directly.
CCA_AUCTION_ADDRESS=

# ---- script/LaunchCcaSepolia.s.sol (all optional, defaults shown) ----
# Existing sale token; if unset, a mintable MockLaunchToken is deployed.
# TOKEN_ADDRESS=
# Whole tokens to sell (default 1000000).
# SALE_SUPPLY=1000000
# Floor price in ETH per token, decimal string (default "0.0009765625" ~= 1024 tokens/ETH).
# FLOOR_PRICE_ETH=0.0009765625
# Tick spacing in ETH per token (default floor/64).
# TICK_SPACING_ETH=
# Auction length in blocks; must divide 1e7 (default 100).
# AUCTION_BLOCKS=100
# Blocks from launch tx to start / end to claim (defaults 5 / 10).
# START_DELAY_BLOCKS=5
# CLAIM_OFFSET_BLOCKS=10
# Graduation threshold in ETH (default "0" — demo only, set a real value for production).
# REQUIRED_CURRENCY_RAISED_ETH=0
# Recipients for raised ETH / unsold tokens (default deployer).
# FUNDS_RECIPIENT=
# TOKENS_RECIPIENT=
# CREATE2 salt as uint (default 0).
# CCA_SALT=0

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# ---- Sepolia well-known addresses (provided for reference, do not change) ----
# ContinuousClearingAuctionFactory v2.1.0: 0x000000001F26a0044BaA66024e7b6599c61963F8
# LiquidityLauncher v3.0.0:               0x00004c4ccc709Ef590F7C81102C0689F0263D4e9
# CCALens v2.0.0:                         0xc3C65F5453A3674aDb693cbdA3C842545cD30f53
# Uniswap v4 PoolManager:                 0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
